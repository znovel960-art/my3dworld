generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum FriendStatus { PENDING ACCEPTED BLOCKED }
enum InviteStatus { PENDING ACCEPTED DECLINED EXPIRED }
model User { id String @id @default(cuid()) username String @unique passwordHash String avatar Json? coins Int @default(1000) gems Int @default(100) level Int @default(1) xp Int @default(0) bio String @default("") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt friendshipsFrom Friendship[] @relation("fromUser") friendshipsTo Friendship[] @relation("toUser") messagesSent Message[] @relation("sender") messagesRecv Message[] @relation("receiver") invitesSent RoomInvite[] @relation("inviteSender") invitesRecv RoomInvite[] @relation("inviteReceiver") inventory InventoryItem[] rooms Room[] }
model Friendship { id String @id @default(cuid()) fromId String toId String status FriendStatus @default(PENDING) createdAt DateTime @default(now()) from User @relation("fromUser",fields:[fromId],references:[id],onDelete:Cascade) to User @relation("toUser",fields:[toId],references:[id],onDelete:Cascade) @@unique([fromId,toId]) }
model Message { id String @id @default(cuid()) senderId String receiverId String? roomId String? text String createdAt DateTime @default(now()) sender User @relation("sender",fields:[senderId],references:[id],onDelete:Cascade) receiver User? @relation("receiver",fields:[receiverId],references:[id],onDelete:Cascade) @@index([roomId,createdAt]) }
model Room { id String @id @default(cuid()) ownerId String name String @default("My Home") layout Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade) }
model RoomInvite { id String @id @default(cuid()) senderId String receiverId String roomId String status InviteStatus @default(PENDING) createdAt DateTime @default(now()) expiresAt DateTime sender User @relation("inviteSender",fields:[senderId],references:[id],onDelete:Cascade) receiver User @relation("inviteReceiver",fields:[receiverId],references:[id],onDelete:Cascade) }
model InventoryItem { id String @id @default(cuid()) userId String itemType String itemKey String quantity Int @default(1) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([userId,itemType,itemKey]) }
